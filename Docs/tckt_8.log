df = spark.sql("""
select 
distinct
SNAME as nama_debitur ,
ACCTNO as no_rek , 
CIFNO as cif , 
plafon as plafond ,
CBAL as os , 
a.branch as kode_uker , 
d.brdesc as branch_name ,
d.REGION as `Kode Kanwil`,
d.RGDESC as `Nama Kanwil`,
id_number as no_nik ,
kelurahan_domisili ,
kecamatan_domisili,
kota_domisili , 
--kodepos_domisili,
--kodepos_id,
--rer_las_perorangan_kelurahan as kelurahan_las ,
--rer_las_perorangan_kecamatan as kecamatan_las,
--dati2 as kota_las , 
`PN` as PN , 
`Nama_Mantri` as nama_mantri





from loan a
inner join type_ c
on
cast(trim(a.CFAREF) as decimal(6,0)) = cast(trim(c.`PN`) as decimal(6,0))
left join branch d

on a.branch = d.branch
left join mdm b
on a.CIFNO = b.`cfcif#`

--left join las e
--on a.CIFNO = e.`edw_brinet_cfcif#_cfcif#`

--left join dati f
--on rer_las_perorangan_lokasi_dati_2 = kode_dati2


""")
df.createOrReplaceTempView("df")


df_distinct = spark.sql("""
select *  ,
(row_number() over (PARTITION BY no_rek  ORDER BY kota_domisili asc)) as row
from df

""").where("row=1")
df_distinct = df_distinct.drop("row")

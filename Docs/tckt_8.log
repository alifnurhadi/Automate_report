SELECT CASE WHEN B.SEGMEN_DASHBOARD='Consumer' THEN 'Konsumer'
  WHEN B.SEGMEN_DASHBOARD='Corporate' THEN 'Korporasi'
  WHEN B.SEGMEN_DASHBOARD='Micro' THEN 'Mikro' 
  WHEN B.SEGMEN_DASHBOARD='Medium' OR B.SEGMEN_DASHBOARD='Small' THEN 'SME' END AS  [SEGMEN PINJAMAN]
	  ,[ACCTNO] AS REKENING
      ,[CIFNO] AS DEBITUR
      ,sum([CBAL_BASE]) AS [BAKI DEBET]
	  ,WAR = sum(CBAL_BASE*rate)/NULLIF(sum(CBAL_BASE), 0)
  FROM [8989_BISDWH_YYYYMM].[dbo].[001_LOANMASTER] AS A WITH(NOLOCK)  
  LEFT JOIN [8989_BISDWH].[dbo].[PAR_SEGMEN_ACRS] AS B WITH(NOLOCK) ON A.FKSEGMEN=B.SEGMEN
  WHERE B.SEGMEN_DASHBOARD IS NOT NULL
  AND A.STATUS NOT IN (2,4,8) 
  GROUP BY B.SEGMEN_DASHBOARD ,[ACCTNO] ,[CIFNO] ,[CBAL_BASE]

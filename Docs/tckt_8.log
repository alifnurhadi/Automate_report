 WITH CTE_PRODUKTIVITAS as (
SELECT  *
  FROM [DASHBOARD_FST_FACT].[dbo].[FACT_PRODUKTIVITAS_EDC_MERCHANT_DOWNLOAD] WITH (NOLOCK)
  WHERE PERIODE = '2023-11'
  )
  SELECT
        A.[TAHUN]
      ,A.[PERIODE]
      ,A.[POSISI]
      ,A.[REGION]
      ,A.[RGDESC]
      ,A.[MAINBR]
      ,A.[MBDESC]
      ,A.[BRANCH]
      ,A.[BRDESC]
      ,A.[TID]
      ,A.[MID]
        ,LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(A.NAMA_MERCHANT)), CHAR(9), ' '), CHAR(10), ' '), CHAR(11), ' '), CHAR(12), ' '), CHAR(13), ' '), '|', ''),'É','E'))) as NAMA_MERCHANT  
      ,A.[JENIS]
      ,A.[SOURCE]
      ,A.[KANWIL_PEMRAKARSA]
      ,A.[KANWIL_NAMA_PEMRAKARSA]
      ,A.[UKER_PEMRAKARSA]
      ,A.[UKER_NAMA_PEMRAKARSA]
      ,A.[KANWIL_IMPLEMENTOR]
      ,A.[KANWIL_NAMA_IMPLEMENTOR]
      ,A.[UKER_IMPLEMENTOR]
      ,A.[UKER_NAMA_IMPLEMENTOR]
      ,A.[PN_USER_PEMRAKARSA]
      ,A.[NAMA_USER_PEMRAKARSA]
      ,A.[LAST_AVAILABLE]
      ,A.[STATUS_AVAILABLE]
      ,A.[LAST_UTILITY]
      ,A.[STATUS_UTILITY]
      ,A.[LAST_TRANSACTIONAL]
      ,A.[STATUS_TRANSACTIONAL]
        ,LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(A.ALAMAT_MERCHANT)), CHAR(9), ' '), CHAR(10), ' '), CHAR(11), ' '), CHAR(12), ' '), CHAR(13), ' '), '|', ''))) as ALAMAT_MERCHANT
      ,A.[KELURAHAN]
      ,A.[KECAMATAN]
      ,A.[KABUPATEN]
      ,A.[PROVINSI]
      ,A.[AKTIF_OR_STAGING]
      ,A.[KET_MCC]
      ,A.[KODE_MCC]
      ,A.[NOREK]
      ,A.[SALES_VOLUME]
      ,A.[JML_TRANSAKSI]
      ,A.[RATAS_SALES_VOLUME_PRODUKTIVITAS]
      ,A.[SALDO_POSISI]
      ,A.[RATAS_SALDO_PRODUKTIVITAS]
	   ,A.[TGL_AVAILABLE_PASANG]
      ,[STATUS_PRODUKTIF]   = CASE WHEN  A.[KETERANGAN]  = 'KURANG DARI 3 BULAN' THEN 'ONLY' ELSE A.[STATUS_PRODUKTIF] END
      ,A.[KETERANGAN]  FROM CTE_PRODUKTIVITAS A where region = 'Q'



demikian yang dapat disampaikan. atas perhatian dan kerjasama yang telah terjalin dengan baik diucapkan terima kasih.
        server : 172.18.41.31
        table :abcs_m_cfmast | stg_lnmast_yyyymmdd
        database : 0000_staging_tl_eom_yyyymm
        disclaimer : data bersumber dari hasil ekstraksi core banking dnets.
        pengerjaan : DECLARE @POSISI AS DATETIME
DECLARE @POSISI1 AS DATETIME

SET @POSISI = (SELECT [DBO].[FormatJulian](NEXTDT7) FROM ABCS_P_DDPAR1)
SET @POSISI1 = (SELECT DATEADD(dd,-(DAY(@POSISI)-1),@POSISI))

;WITH PMTAMT AS (
SELECT X.CRACCT, B.SEQ, B.AMOUNT, TRFDATE7
FROM (
SELECT CRACCT, MAX(SEQUENCE) SEQUENCE
FROM ABCS_T_DDAFTH with(NOLOCK)
WHERE [DBO].[FormatJulian](TRFDATE7) BETWEEN @POSISI1 AND @POSISI
AND REASON = 'Success'
GROUP BY CRACCT
) X
JOIN ABCS_T_DDAFTH B with(NOLOCK) ON X.CRACCT = B.CRACCT AND X.SEQUENCE = B.SEQUENCE
)

,BILL AS (
SELECT X.ACCOUNTNUMBER, B.SEQNUM, B.PRINCIPALAMOUNTBILL, B.PRINCIPALAMOUNTPAID
FROM (
SELECT ACCOUNTNUMBER, MAX(SEQNUM) SEQNUM
FROM ABCS_T_LNBILL with(NOLOCK)
WHERE [DBO].[FormatJulian](DATEISSUED7) BETWEEN @POSISI1 AND @POSISI
GROUP BY ACCOUNTNUMBER
) X
JOIN ABCS_T_LNBILL B with(NOLOCK) ON X.ACCOUNTNUMBER = B.ACCOUNTNUMBER AND X.SEQNUM = B.SEQNUM
)

--SELECT DRACCT, COUNT(1)
--FROM PMTAMT with(NOLOCK)
--GROUP BY DRACCT
--HAVING COUNT(1)>1


--===================================

SELECT
	[DBO].[FormatJulian](X.NEXTDT7) AS VALID_ON
	,A.STATUS
	,A.ACCOUNTNUMBER AS ACCTNO
	,[dbo].[FormatJulian](A.OPENDAT7) AS DATOPN_DT
	,[dbo].[FormatJulian](A.MATURITYDATE7) AS MATDT_DT
	,[dbo].[FormatJulian](A.NEXTBILLINGISSUED7) AS NPDT8
	,[dbo].[FormatJulian](A.OPENDAT7) AS FRELDT_DT
	,A.CIFNUM AS CIFNO
	,A.LOANTYPE AS TYPE
	,B.GROUPCODE
	,LEFT(A.ACCOUNTNUMBER,4) AS BR#
	,A.RATE
	,A.PERIOD AS TERM
	,A.PERIODMODE AS TMCODE
	,A.INTPAYMENTFREQ AS IPFREQ
	,A.INTPAYMENTFREQMETHOD AS IPCODE
	,A.REPAYMENTFREQUENCY AS FREQ
	,A.REPAYMENTFREQUENCYMODE AS FRCODE
	,A.CURRENCY AS CURTYP
	,A.CBAL
	--,A.CBAL * KURS KURS BELUM DIAMBIL
	,A.ACCRUE AS ACCINT
	--,A.ACCRUE * KURS KURS BELUM DIAMBIL
	,A.PRINCIPALAMOUNT AS ORGAMT
	--,A.PRINCIPALAMOUNT * KURS KURS BELUM DIAMBIL
	,ISNULL(F.AMOUNT,0) PMTAMT --MASIH DIKONFIRM UNTUK NILAI DOUBLE DI REK 045202001442105, 045202000370101
	,ISNULL(CAST(C.PRINCIPALAMOUNTBILL AS FLOAT),0) AS BILPRN --INFO ADI TL DIAMBIL BULAN BERJALAN SAJA
	,ISNULL((CAST(C.PRINCIPALAMOUNTBILL AS FLOAT) - CAST(C.PRINCIPALAMOUNTPAID AS FLOAT)),0) AS BILPNO --INFO ADI TL DIAMBIL BULAN BERJALAN SAJA
	,(CAST(A.PROVISI AS float)/CAST(A.PRINCIPALAMOUNT AS float)) ADVMRG
	,0 LMOSBL
	,0 LMOSBL_BASE
	,A.PRINCIPALAMOUNT AS AMTREL
	,A.SHORTNAME AS CFSNAME
	,D.NEGARA AS CFCOUN
	,D.KEWARGANEGARAAN AS CFCITZ
	,D.NO_ID AS CFSSNO
	,D.BRANCH_NO AS CFBRNN
	,E.KOLEK AS BIKOLEK
	--,CONVERT(DATETIME, D.TANGGAL_LAHIR, 103) (MASIH ERROR KARENA MASIH LEWAT TGL)
	,D.TANGGAL_LAHIR
	,E.DAYSKOLEK DPD
	,A.FLAG_RESTRUK RESTRUK
--INTO #TEMP
FROM ABCS_M_LNMAST A WITH(NOLOCK)
LEFT JOIN ABCS_P_LNPAR2 B WITH(NOLOCK) ON A.LOANTYPE = B.LOANTYPE
LEFT JOIN BILL C WITH(NOLOCK) ON A.ACCOUNTNUMBER = C.ACCOUNTNUMBER
LEFT JOIN ABCS_M_CFMAST D WITH(NOLOCK) ON A.CIFNUM = D.CIFNUM
LEFT JOIN ABCS_M_LNBICD E WITH(NOLOCK) ON A.ACCOUNTNUMBER = E.ACCOUNTNUMBER
LEFT JOIN PMTAMT F with(NOLOCK) ON A.ACCOUNTNUMBER = F.CRACCT --CEK LAGI, MASIH ADA YG DOUBLE 2 REKENING (MASIH DI MAKESURE KE ADI TL ANGKA SEHARUSNYA)
CROSS JOIN ABCS_P_DDPAR1 X
--WHERE a.ACCOUNTNUMBER = '045202000398109'


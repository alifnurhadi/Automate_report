Transaksi yang diminta adalah sepanjang november 2023 query :None pseudo : 1. query transaksi
with tartun_brimo as (
    select seconddata4 acctno, cast(txamount/100 as decimal(32,2)) amt from datalake.echannel_trx_dwh_prosw_transaction
    where year = '2023' and month = '11' and day = '01'
    and fiturid = 103090171
    and terminaltype in ('ATM MERAH PUTIH', 'ATM_BRI', 'CDM')
    limit 5
)

select acctno, 'Tarik Tunai via BRImo' jenis, '' corp_name,
null svcId, null svcDs, 'ATM/CRM' terminalType, amt, '{}' json_data
from tartun_brimo
union all
SELECT 
accdebet,
case 
    when channelid = 'NBMB' and lower(get_json_object(json_data, '$.serviceDesc')) like '%transfer%'
        and lower(get_json_object(json_data, '$.serviceDesc')) not like '%fund transfer other bank%'
        and upper(get_json_object(json_data, '$.serviceId')) not in ('0008G','0007V')
        then 'Transfer Sesama BRI'
    when channelid = 'NBMB' and lower(get_json_object(json_data, '$.serviceDesc')) like '%transfer%'
        and (lower(get_json_object(json_data, '$.serviceDesc')) like '%fund transfer other bank%'
            or lower(get_json_object(json_data, '$.serviceDesc')) like '%transfer outbound bi fast%')
        and upper(get_json_object(json_data, '$.serviceId')) not in ('0007V')
        then 'Transfer Bank Lain' -- transfer bank lain termasuk bifast
    when channelid = 'ATM0' and fiturid = 'ATM0000DJ' then 'Setor Tunai via BRImo'
    when channelid = 'NBMB' and fiturid in ('NBMB02004', 'NBMB02006') then 'TopUp Brizzi'
    when (channelid = 'NBMB' and fiturid = 'NBMB02002' 
        and lower(get_json_object(json_data, '$.REQUEST.CORP_NAME')) 
            in ('ovo', 'shopeepay', 'linkaja', 'dana', 'i saku')) or 
        (fiturid in ('NBMB02010', 'NBMB02011', 'NBMB02012')) -- ini topup gopay 
        then 'TopUp Dompet Digital'
    when channelid = 'NBMB' and fiturid in ('NBMB01001', 'NBMB01002', 'NBMB01003', 'NBMB01004', 
        'NBMB01005', 'NBMB01006', 'NBMB01007', 'NBMB01008', 'NBMB01009', -- NMBMB01001 s.d NBMB01009 itu pulsa
        'NBMB01026', 'NBMB01024', 'NBMB0005S') -- ini data, cuma tersedia telkomsel sama indosat aja (cek aja di brimo)
        then 'TopUp Pulsa/Data' 
    when channelid = 'NBMB' and fiturid in ('NBMB04002', 'NBMB04004', 'NBMB04007') then 'Pembayaran Listrik'
    when channelid = 'NBMB' and fiturid = 'NBMB04031' then 'Pembayaran PDAM' -- bjir ini nama servicenya payment pln padahal pdam
    when channelid = 'NBMB' and fiturid = 'NBMB01013' then 'Pembayaran Telkom'
    when channelid = 'NBMB' and fiturid in ('NBMB000BW', 'NBMB07002', 'NBMB07009') then 'Pembayaran Asuransi' -- sesuai konfirmasi user
end jenis,
lower(get_json_object(json_data, '$.REQUEST.CORP_NAME')) corp_name,
lower(get_json_object(json_data, '$.serviceId')) svcId,
lower(get_json_object(json_data, '$.serviceDesc')) svcDs,
channelid,
cast(cast(amtdebet as decimal(38,2))/100 as decimal(38,2)) amtdebet,
json_data
FROM datalake.staging_esb_raw_dly_esb_trx 
where left(ds, 6) = '202311'
and responcode = '00'
LIMIT 100; 


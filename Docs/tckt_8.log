ISNULL(LTRIM(RTRIM(h.CFEADD)), '') TELP_KANTOR, 
ISNULL(LTRIM(RTRIM(i.CFEADD)), '') HANDPHONE,
ISNULL(LTRIM(RTRIM(j.CFEAD1)), '') EMAIL,
a.DIVISI
from temp_table a with (nolock)
LEFT JOIN [0000_Staging]..AS4_CFMAST b with (nolock)
ON a.CIF = b.CFCIF#
LEFT JOIN [0000_Staging]..AS4_CFADDR d with (nolock)

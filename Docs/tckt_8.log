CONCAT(LTRIM(RTRIM(d.CFNA2)), ', ', LTRIM(RTRIM(d.CFNA3)), ', ', LTRIM(RTRIM(d.CFNA4)), ', ', LTRIM(RTRIM(d.CFNA5))) ALAMAT_DOMISILI,
CONCAT(LTRIM(RTRIM(e.CFNA2)), ', ', LTRIM(RTRIM(e.CFNA3)), ', ', LTRIM(RTRIM(e.CFNA4)), ', ', LTRIM(RTRIM(e.CFNA5))) ALAMAT_KANTOR,

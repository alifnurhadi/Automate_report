WITH CTE AS (
SELECT 
	[TAHUN]
	,[PERIODE]
	,[POSISI]
	,[KANWIL]
	,CONVERT(DECIMAL(5, 0), CASE WHEN TRY_CAST(A.[KODE_BRANCH] AS DECIMAL(5, 0)) IS NOT NULL THEN A.[KODE_BRANCH] ELSE NULL END) AS [KC_SPV_KODE]
	,CONVERT(DECIMAL(5, 0), CASE WHEN TRY_CAST(A.[KODE_BRANCH_PENGELOLA] AS DECIMAL(5, 0)) IS NOT NULL THEN A.[KODE_BRANCH_PENGELOLA] ELSE NULL END) AS [PENGELOLA_KODE]
	,[TID] AS [TERMINALID]
	,[LOKASI]
	,COALESCE([OPS_TIME], '-') AS OPS_TIME
	,coalesce([RTL_PROBLEM], '-') AS STATUS_ATM
	,COALESCE([WAKTU_INSERT], '') AS WAKTU_INSERT
	,[FITURID]
	,[GROUPNAME] = 'Setor Tunai'
	,[FITURNAME]
        ,[ECH]
        ,[LOKASI_JENIS]
	,case when [responcode] = '00' then SUM(SALES_VOLUME)
	else 0
	end as  NOMINALSUKSES
	,case when [responcode] = '00' then SUM(JML_TRX)
	else 0
	end as  TOTALSUKSES
	,case when [responcode] <> '00' then SUM(SALES_VOLUME)
	else 0
	end as  NOMINALGAGAL
	,case when [responcode] <> '00' then SUM(JML_TRX)
	else 0
	end as  TOTALGAGAL
from [MASTER_ATM].[dbo].[FCT_MAST_TRX_ATM_202311] A
where fiturid = 'atm0000dj'

GROUP BY [TAHUN]
	,[PERIODE]
	,[POSISI]
	,[KANWIL]
	,CONVERT(DECIMAL(5, 0), CASE WHEN TRY_CAST(A.[KODE_BRANCH] AS DECIMAL(5, 0)) IS NOT NULL THEN A.[KODE_BRANCH] ELSE NULL END) 
	,CONVERT(DECIMAL(5, 0), CASE WHEN TRY_CAST(A.[KODE_BRANCH_PENGELOLA] AS DECIMAL(5, 0)) IS NOT NULL THEN A.[KODE_BRANCH_PENGELOLA] ELSE NULL END) 
	,[TID] 
	,[LOKASI]
	,[OPS_TIME]
	,coalesce([RTL_PROBLEM], '-')
	,[WAKTU_INSERT]
	,[FITURID]
	,[GROUPNAME]
	,[FITURNAME]
	,[RESPONCODE]
	)


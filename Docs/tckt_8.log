        server : 172.18.141.86 | bigdata
        table :8000_rc_trx_as4_ddhist | dly_customer_info | asrs_daily_fact_savingmaster
        database : 6969_crm | datalake
        disclaimer : data bersumber dari datamart simpanan, datamart customer dan ekstraksi brinets.
        pengerjaan : None query :Tersedia di comment pseudo : running query ini jika data savingmaster posisi tgl 20231214 tersedia (H+2 dari hari ini)
with demograf as (SELECT CFCIF# cifno,JENIS_KELAMIN,datediff(year,tanggal_lahir,getdate()) usia,KOTA_DOMISILI,JENIS_PEKERJAAN,SUMBER_PENGHASILAN,PENDIDIKAN
  FROM [6969_CRM].[dbo].[DLY_CUSTOMER_INFO])
,base as (select 
cifno,acctno,date_add(a.open_date,1) open,date_add(STATUS_DATE,1) close,b.region region_pembuka,b.rgdesc RGDESC_pembuka,b.MAINBR mainbr_pembuka,b.MBDESC mainbr_pembuka,
b.BRANCH branch_pembuka,b.BRDESC brdesc_pembuka,
b.region region_penutup,b.RGDESC rgdesc_penutup,b.MAINBR mainbr_penutup,b.MBDESC mbdesc_penutup,b.BRANCH branch_penutup,b.BRDESC brdesc_penutup
,RATAS_SALDO_GL,
replace(left(cast(status_date as varchar(20)),7),'-','') akhir,
replace(left(cast(date_add(status_date,-365) as varchar(20)),7),'-','') awal
from asrs_daily_fact_savingmaster a 
left join `6969_crm_dim_dwh_branch` b on a.branch = b.branch 
where ds = '20231214' and 
date_add(STATUS_DATE,1) between '2023-01-01' and '2023-12-14' 
and STATUS = 2 and GROUP_TYPE in ('Simpedes','Britama')),
jmltrx as (
select concat(year,month) ds,tracct,count(0) trx from `8000_rc_trx_as4_ddhist` a inner join base b
on a.tracct = b.acctno
where concat(year,month) between b.awal and b.akhir and trdorc = 'D'
group by
concat(year,month),tracct
), ratas_trx as (
select tracct,avg(trx) ratas_trx from jmltrx
group by tracct)
select c.*,a.*,b.* from base a 
left join ratas_trx b on a.acctno = b.tracct
left join demograf c on a.cifno = c.cifno

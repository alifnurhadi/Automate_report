        pengerjaan : 172.18.141.52 = 2021 sd 2022 query :DECLARE @INISIAL VARCHAR(20)
DECLARE @QUERY varchar(4000)
DECLARE @norek varchar(4000)
DECLARE @nama varchar(4000)
DECLARE @filename varchar(100)


SET @INISIAL = 1
WHILE @INISIAL <= 230474 --sesuaikan dengan jumlah norek
BEGIN SELECT @norek = dbo.fnRemoveNonNumericCharacters([norek])
 FROM [1000_PAR].[dbo].[__tmp1719new] WITH(NOLOCK) --sesuaikan dengan table acuan
where [no] = @INISIAL

SET @filename = +@INISIAL+'_'+'RK_1719_'+@norek+'_'+'2021_2022'+''

EXEC [8000_RC_MASTER].dbo.[REQUEST_ACCOUNT_STATEMENT_CHANNEL]
@norek --Norek
,'20210101' -- Tanggal Awal YYYYMMDD
,'20221231' -- Tanggal Akhir YYYYMMDD
,@filename -- Filename
,'PDF' -- Typefile PDF/CSV, jika Excel CSV
,'ADHOC' -- Nama Channel, isi ADHOC saja
,'EDMDRE' -- Nama penarik
,'255.255.255.255' -- Ip Optional

SET @INISIAL = @INISIAL+1
END  pseudo : --141.52

DECLARE @INISIAL VARCHAR(20)
DECLARE @QUERY varchar(4000)
DECLARE @norek varchar(4000)
DECLARE @nama varchar(4000)
DECLARE @filename varchar(100)


SET @INISIAL = 1
WHILE @INISIAL <= 3398 --sesuaikan dengan jumlah norek
BEGIN SELECT @norek = dbo.fnRemoveNonNumericCharacters([No Rekening]), @nama = RTRIM(LTRIM([Nama]))
 FROM [1000_PAR].[dbo].[temp23_1658] WITH(NOLOCK) --sesuaikan dengan table acuan
where [no] = @INISIAL

SET @filename = 'RK_1658_'+@norek+'_'+@nama+''

EXEC [8000_RC_MASTER].dbo.[REQUEST_ACCOUNT_STATEMENT_CHANNEL]
@norek --Norek
,'20210101' -- Tanggal Awal YYYYMMDD
,'20221231' -- Tanggal Akhir YYYYMMDD
,@filename -- Filename
,'PDF' -- Typefile PDF/CSV, jika Excel CSV
,'ADHOC' -- Nama Channel, isi ADHOC saja
,'EDMDRE' -- Nama penarik
,'255.255.255.255' -- Ip Optional

SET @INISIAL = @INISIAL+1
END 

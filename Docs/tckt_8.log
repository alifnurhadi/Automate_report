	from stagingData.krp01.kreditPembiayaan_FINAL_202306 a --DATA ANTASENA SEBELUM AUDIT POSISI 202306
	left join stagingData.pl01.pihakLawan b on a.idDebitur = b.idPihakLawan and a.idPelapor = b.idPelapor
	left join ANTASENA..TEMP_PIHAK_LAWAN_EKSISTING c on a.idDebitur = c.idPihakLawan and a.idPelapor = c.idPelapor and b.idPihakLawan is null
	right join TEMPFORDELETE..NOREK_ATMR_UMKR_SEBELUM_AUDIT d --DATA ATMR SEBELUM AUDIT POSISI 202306
	on d.ACCTNO = REPLACE(LTRIM(REPLACE(a.nomorRekening,'0', ' ')),' ','0')

--setelah audit
select 
	a.nomorRekening
	,d.ACCTNO
	,case 
		when b.golonganPihakLawan is not null then b.golonganPihakLawan
		when c.golonganPihakLawan is not null then c.golonganPihakLawan
		else null end as golongan 

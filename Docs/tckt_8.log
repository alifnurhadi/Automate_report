DECLARE @INISIAL VARCHAR(20)
DECLARE @nomor VARCHAR(1000)
DECLARE @QUERY varchar(4000)
DECLARE @no_rek varchar(4000)
SET @INISIAL = 1

WHILE @INISIAL <= 11 -- disesuaikan nomor urut brp jumlah hari dalam sebulan selama periode yg diminta
BEGIN
SELECT @startdate = startdate, @endate = enddate FROM [1000_PAR].[dbo].[TEMP
                where [No] = @INISIAL
                
SELECT @no_rek = Nomor_Rekening FROM [1000_PAR].[dbo].[TEMP]
                where [No] = @INISIAL
                
SET @QUERY = 'EXEC [REQUEST_ACCOUNT_STATEMENT_CHANNEL]
'''+@no_rek+'''
,'''+@startdate+'''
,'''+@enddate+'''
,''rahasia'+'_'+@no_rek+'_'+@enddate+'''
,''CSV''
,''ADHOC''
,''EDMDRE''
,''255.255.255.255'''

EXEC(@QUERY)
                
SET @INISIAL = @INISIAL+1

END

def lastPartition(schema, table):
  return spark.sql(""" 
   show partitions {}.{}
   """.format(schema, table)) \
  .sort('partition', ascending=False) \
  .limit(1) \
  .collect()[0][0]
  
  

def writeTable(df, hive_db, hive_table):
  df\
    .sample(False,0.1,None)\
    .write\
    .format("parquet")\
    .mode("overwrite")\
    .saveAsTable("temp.sample_{}".format(hive_table))
  path = lambda p: spark._jvm.org.apache.hadoop.fs.Path(p)
  try:
    fs = spark._jvm.org.apache.hadoop.fs.FileSystem.get(spark._jsc.hadoopConfiguration())
    hdfs_folder = fs.getContentSummary(path("/user/hive/warehouse/temp.db/sample_{}/".format(hive_table)))
    repartition_number = float(hdfs_folder.getLength()*10)/float(128*1024*1024)
    repartition_number = int(1 if repartition_number < 1 else repartition_number)
  except:
    print('Table Tidak Ada')
    repartition_number = 1
    
  spark.sql("DROP TABLE temp.sample_{}".format(hive_table))
  df = df.repartition(repartition_number)
  df\
    .write\
    .format("parquet")\

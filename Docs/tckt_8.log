--sebelum audit
select 
	a.nomorRekening
	,d.ACCTNO
	,case 
		when b.golonganPihakLawan is not null then b.golonganPihakLawan
		when c.golonganPihakLawan is not null then c.golonganPihakLawan
		else null end as golongan 
	,a.kategoriUsahaDebitur
	,a.kualitas
	,a.sektorEkonomi
	,d.SALDO_TOTAL as jmlBulanLaporan
	,d.SALDO_PENJAMIN as bagianDijamin

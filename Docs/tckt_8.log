a.SNAME NAMA,
b.CFSSNO NO_IDENTITAS,
c.CFIDSC JENIS_IDENTITAS,
CONCAT(LTRIM(RTRIM(d.CFNA2)), ', ', LTRIM(RTRIM(d.CFNA3))) ALAMAT_DOMISILI,
CONCAT(LTRIM(RTRIM(e.CFNA2)), ', ', LTRIM(RTRIM(e.CFNA3))) ALAMAT_KANTOR,
ISNULL(LTRIM(RTRIM(g.CFEADD)), '') TELP_RUMAH,
ISNULL(LTRIM(RTRIM(h.CFEADD)), '') TELP_KANTOR,
ISNULL(LTRIM(RTRIM(i.CFEADD)), '') HANDPHONE,
ISNULL(LTRIM(RTRIM(j.CFEAD1)), '') EMAIL,
CASE
WHEN k.CFOCCD = 'ZZZZZ' THEN l.CFRMK1
ELSE m.CFOCPD
END JENIS_PEKERJAAN,
ISNULL(LTRIM(RTRIM(n.CFSSNO)), '') NPWP
from [0000_Staging_EOM]..AS4_LNMAST a with (nolock)
LEFT JOIN [0000_Staging]..AS4_CFMAST b with (nolock)
ON a.CIFNO = b.CFCIF#
LEFT JOIN [0000_Staging]..AS4_CFIDDF c with (nolock)
ON b.CFSSCD = c.CFIDCD
LEFT JOIN [0000_Staging]..AS4_CFADDR d with (nolock)
ON a.CIFNO = d.CFCIF# and d.CFASEQ = 3
LEFT JOIN [0000_Staging]..AS4_CFADDR e with (nolock)
ON a.CIFNO = e.CFCIF# and e.CFASEQ = 2
LEFT JOIN [0000_Staging]..AS4_CFADDR f with (nolock)
ON a.CIFNO = f.CFCIF# and f.CFASEQ = 1
LEFT JOIN [0000_Staging]..AS4_CFCONN g with (nolock)
ON a.CIFNO = g.CFCIF# and g.CFEADC = 'TR'
LEFT JOIN [0000_Staging]..AS4_CFCONN h with (nolock)
ON a.CIFNO = h.CFCIF# and h.CFEADC = 'TK'
LEFT JOIN [0000_Staging]..AS4_CFCONN i with (nolock)
ON a.CIFNO = i.CFCIF# and i.CFEADC = 'HP' and i.CFZSEQ = 21
LEFT JOIN [0000_Staging]..AS4_CFCONN2 j with (nolock)
ON a.CIFNO = j.CFCIF# and j.CFEADC = 'EM'
LEFT JOIN [0000_Staging]..AS4_CFJOBI k with (nolock)
ON a.CIFNO = k.CFCIF#
LEFT JOIN [0000_Staging]..AS4_CFFREE l with (nolock)
ON k.CFCIF# = l.CFCIF# and l.CFTYPE = 'OCD'
LEFT JOIN [0000_Staging]..AS4_CFZPOC m with (nolock)
ON k.CFOCCD = m.CFOCPC
LEFT JOIN (
SELECT
RN = ROW_NUMBER() OVER(PARTITION BY cfcif# order by CFVDT7 desc),
CFCIF#,
CFSSNO

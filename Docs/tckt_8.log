WHERE [CFSSCD] = 'NP' AND [CFSSNO] IS NOT NULL AND [CFSSNO] <> ''
) n ON a.CIFNO = n.cfcif# and RN = 1
where a.ACCTNO = 221801000253159  pseudo : select
b.CFSSNO NO_IDENTITAS,

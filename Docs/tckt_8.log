	,[OPS_TIME]
	,[STATUS_ATM]
	,[WAKTU_INSERT]
	,[FITURID]
	,[GROUPNAME]
	,[FITURNAME]
	,[NOMINALSUKSES]
	,[TOTALSUKSES]
	,[NOMINALGAGAL]
	,[TOTALGAGAL]
FROM CTE A
left join [0000_STAGING].[dbo].[DWH_BRANCH] B
	on A.[KC_SPV_KODE] = B.[BRANCH] 
left join [0000_STAGING].[dbo].[DWH_BRANCH] C
	ON A.[PENGELOLA_KODE] = C.[BRANCH]

--Linkaja (query masih berupa posisi harian, running untuk posisi 1 bulan)
select
	[tahun] = LEFT(convert(varchar(10),[transdate],120),4)
	,[periode] = LEFT(convert(varchar(10),[transdate],120),7)
	,posisi = convert(date,[transdate])
	,c.[kanwil_atmpro] AS kanwil
	,e.mainbr
	,c.[kc_spv_kode] 
	,c.[kc_spv]
	,c.[pengelola_kode]
	,c.pengelola
	,a.termid as terminalid
    ,c.[lokasi_atmpro] AS lokasi
	,c.[ops_time]
	,d.[waktu_insert]
	,[FiturID] = '103090172'
	,groupname = 'TarikTunai'
	,fiturname = 'Tarik tunai tanpa kartu LINK AJA (cardless withdrawal)'
	,COALESCE(d.rtl_problem, '-') AS status_atm
	,c.ech
	,c.lokasi_jenis
	,case when [responcode] = '00' then SUM(a.[txamount]/100.00)
	else 0
	end as  NominalSukses
	,case when [responcode] = '00' then count(0)
	else 0
	end as  TotalSukses
	,case when [responcode] <> '00' then SUM(a.[txamount]/100.00)
	else 0
	end as  NominalGagal
	,case when [responcode] <> '00' then count(0)
	else 0
	end as  TotalGagal
FROM [ECHANNEL_202311].[dbo].[DWH_PROSW_TRANSACTION_UNPROCESSED_20231101] a with (nolock) 
right join [000_JKE]..[1500_1011_atm_zona] c with (nolock)
	on a.termid = RIGHT('00000000'+RTRIM(c.tid),8)
LEFT JOIN [000_JKE].[dbo].[1500_1011_atmpro_dt] d with (nolock)
	on a.termid = RIGHT('00000000'+RTRIM(d.tid),8)
LEFT JOIN [0000_STAGING]..[DWH_BRANCH] e
	ON e.mainbr = c.[kc_spv_kode]
where a.[TerminalType] in ('ATM MERAH PUTIH','ATM_BRI','CDM')
	and proccode = '150300' 
	and ([product-id] = 'ERBRI' or seconddata1 = 'ERBRI') 
	and [i-tobranch] in (0) 
	and LTRIM(RTRIM(LEFT(seconddata5,7))) = 'LINKAJA'
group by 	
	[transdate]
	,c.[kanwil_atmpro]
	,mainbr
	,c.[kc_spv_kode] 
	,c.[kc_spv]
	,c.[pengelola_kode]

3. finalisasi generate detail data rincian, sesuaikan posisi db dengan permintaan - 141.26
WITH BASED AS (
	SELECT A.* FROM (
		SELECT 
			ROW_NUMBER() OVER(PARTITION BY A.CIFNO ORDER BY A.FRELDT_DT DESC ) URUT, A.* 
		FROM [1000_PAR]..adhoc_sikp_kur_naik_kelas_baseline_baru A WITH(NOLOCK)
		inner join [8989_BISDWH_202212]..[001_LOANMASTER] B WITH(NOLOCK) --> disesuaikan dg posisi baseline yg dminta
			ON A.ACCTNO  = B.ACCTNO
		WHERE B.STATUS NOT IN (2,4,8)
	) A
	WHERE URUT = 1
), AKTIF_EXCLUDE_KONSUMER AS (
	SELECT 
		A.CIFNO,A.ACCTNO, FRELDT_DT,MATDT_DT, FKSEGMEN, TYPE,ORGAMT_BASE AS PLAFOND, B.PRODUK_DASHBOARD,B.SEGMEN_DASHBOARD, a.posisi
	FROM [8989_BISDWH_202310]..[001_LOANMASTER] A WITH(NOLOCK)  --> disesuaikan dengan posisi data yg diminta
	INNER JOIN [8989_BISDWH]..PAR_SEGMEN_ACRS B WITH(NOLOCK)
		ON A.FKSEGMEN = B.SEGMEN
	WHERE  B.SEGMEN_DASHBOARD NOT IN ('CONSUMER')
	AND A.STATUS NOT IN (2,4,8)
	AND A.CBAL_BASE > 0

)
SELECT 
A.*,
	B.ACCTNO AS REKENING_BARU,B.TYPE AS LOANTYPE_BARU, B.FKSEGMEN, B.FRELDT_DT TGL_REALISASI_BARU, C.PENGGUNAAN AS PENGGUNAAN_BARU, B.PRODUK_DASHBOARD,B.SEGMEN_DASHBOARD, B.PLAFOND AS PLAFOND_BARU
--INTO [1000_PAR].dbo.adhoc_sikp_kur_naik_kelas_202310_baru
FROM BASED A WITH(NOLOCK)
INNER JOIN AKTIF_EXCLUDE_KONSUMER B WITH(NOLOCK)
	ON A.CIFNO = B.CIFNO
	AND B.FRELDT_DT > A.FRELDT_DT
LEFT JOIN [1000_PAR]..ADHOC_MAPPING_KUR C WITH(NOLOCK)
	ON B.TYPE = C.LOAN_TYPE
WHERE year(b.FRELDT_Dt)= year(b.posisi)
and month(b.FRELDT_DT) =  month(b.posisi) --> disesuaikan dg permintaan posisi data 

2. finalisasi
dapat mengikuti langkah 1 dan 2 di tiket ERA23-1100 menggunakan baseline dari poin 1 sesuai posisinya
untuk tanggal lunas joinkan norek ke lnmast untuk logicnya dapat mengikuti tiket ERA23-1498



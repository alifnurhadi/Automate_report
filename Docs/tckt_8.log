periode = []

for i in range(1,12):
  per = '2023'+ str(i).zfill(2)
  periode.append(per)
  



for per in periode:
  print(per)
  
  df = spark.sql(f"""
      select
distinct
b.ds posisi,
b.nama_nasabah,
b.norek,
b.fasilitas_rekening,
d.cellphone_number no_hp,
a.merchant_name,
a.merchant_location,
a.postal_code,
a.is_similarity,
a.similarity_with
from (
    select distinct merchant_id, merchant_name, merchant_location, postal_code, is_similarity, similarity_with
    from datamart.satgas_dana_qris_summarize_transaction_3
    where ds in ('202311') -- ini biarin aja filter posisi terbaru, soalnya datanya akumulasi
    and qr_status = 'off us'
    and lower(trim(rgdesc)) = 'makassar'
) a
inner join (
    select left(ds,6) ds,
    get_json_object(payment_object_esb, '$.REQUEST.pan') pan,
    coalesce(
        get_json_object(payment_object_esb, '$.REQUEST.customerData'),
        get_json_object(payment_object_esb, '$.REQUEST.CustomerData')
    ) nama_nasabah,
    account norek,
    payment_object_esb,
    'QRIS' fasilitas_rekening, -- ini tuh jenis transaksinya qris/edc
    '' no_telp
    from datalake.qr_mpm_tcico_tbl_trx_purchase_qr
    where left(ds,6) in ('{per}') -- sesuaikan posisi ini dengan permintaan
) b on a.merchant_id = b.pan
left join (
    select distinct account, username
    from datalake.brimo_superapps_source_ib_user_account_brimo
    where ds like '{per}%' -- sesuaikan posisi ini dengan permintaan
) c on b.norek = c.account
left join (
    SELECT distinct username, cellphone_number
    FROM datalake.echannel_ib_user_profile
    where ds = '{per}' -- sesuaikan posisi ini dengan permintaan
) d on c.username = d.username
      """)
  
  df.createOrReplaceTempView('df')
    

  final = spark.sql(f"""
        select  a.posisi,
a.nama_nasabah `Nama Nasabah`,
a.norek `No Rekening`,
a.fasilitas_rekening `Fasilitas Rekening`,
a.no_hp `No. Tlp`,
a.merchant_name `Nama Merchant Bank Lain`,
        concat(b.cp2kec,',',b.cp2cty,',',b.cp2pro, ' kodepos:', postal_code) Alamat_Merchant,
        case when c.NAMA_MERCHANT is null then 'tidak ada' else c.NAMA_MERCHANT end `Nama Merchant BRI jika ada`
        from temp.df23_1807 a
        left join (
        select distinct cp2zip, upper(cp2pro) cp2pro,
trim(replace(replace(replace(replace(replace(replace(upper(cp2cty), 'KOTA', ''), 'KOT.', ''), 'KAB.', ''), 'KAB .', '') ,'KAB', ''),'ADM','')) cp2cty,
cp2kec
,(row_number() over (PARTITION BY cp2zip  ORDER BY cp2cty desc)) as row
from datalake.`0000_staging_raw_as4_cfpar2l`
where year = 2023 and month = 11 and day = '30'
        ) b 
        on a.postal_code = b.cp2zip
        left join (
         select MERCHANT_PAN, NAMA_MERCHANT
            from datalake.dashboard_rpt_fact_merchant_qris_detil 
            where ds = '202311' and MERCHANT_PAN is not null
        ) c
        on a.similarity_with = c.MERCHANT_PAN
        where a.posisi = '{per}'
        and b.row=1
        """)
  
  final.coalesce(1)\
  .write\
  .mode("overwrite")\
  .format("parquet")\
  .csv(f"hdfs:///user/00320434/ERA23-1807/1/{per}",
      header = True,
      sep = "|") pseudo : 1. baseline

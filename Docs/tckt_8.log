with alldatas as (
select CIF, [Rekening]
,Remark3
,[Product Code]
,[TXN Date]
,[Jumlah_Trx] = count(*)
,[Total_Amt] = sum([Amount])
,[Total_Fee] = sum([Amount_Fee])
,[Channel]
from (
select distinct
c.[CFSSNO] as CIF
, convert(numeric(19,0),a.[AccDebet]) as [Rekening]
,remark3
, convert(datetime,a.[TanggalTrx]) as [TXN Date]
, a.[FiturId] as [Product Code]
, convert(numeric(32,7),a.[AmtDebet]) as [Amount]
, convert(numeric(32,7),a.[AmtFee]) as [Amount_Fee]
, CASE WHEN a.[ChannelID] = 'NBMB' THEN 'INTERNET BANKING'
WHEN a.[ChannelID] = 'IBIZ' THEN 'INTERNET BANKING BISNIS'
END as [Channel]
from [STAGING_ESB_202311]..ESB_TRX_20231111 a with (nolock)
inner join [0000_STAGING]..[AS4_DDMAST] b with (nolock) on
b.ACCTNO = a.[AccDebet]
inner join [0000_STAGING]..[AS4_CFMAST] c with (nolock) on
c.CFCIF# = b.CIFNO
where a.[Responcode] ='00'
--and ( a.[AmtDebet] is not null or a.[AmtDebet] > 0 )
and ( a.[AmtDebet] is not null or a.[AmtDebet] >= 50000) --BRIPOIN mengakumulasi poin untuk transaksi diatas 50000
and a.[ChannelID] in ('NBMB','IBIZ')
and a.[FiturID] = 'NBMB02002' --ini FiturID BRIVA
and AccDebet='014501026258506' --and Remark3='BRIVA800082351003199NBMBniki_unggu878'
) a
group by CIF, [Rekening]
,Remark3
,[Product Code]
,[TXN Date]
,[Channel]
having count(*) >= 500 --ini filter transaksi diatas 500x dalam sehari
--order by [Jumlah_Trx]
)


        pengerjaan : None query :None pseudo : -- JANUARI
WITH CTE AS (
SELECT POSISI, REGION, MAINBR, BRANCH, 
	RATAS AS RATAS_MARGINAL, RATAS_SALDO_BPR AS RATAS_HISTORICAL,
	NILAI_TERCATAT, A.SANDI, A.PARENT_SANDI, A.FKSEGMEN, B.FLAG_CUR
FROM [2022_AVG_DLY_PINJAMAN_V2]..MASTER_LOANMASTER_202301 A WITH(NOLOCK)
LEFT JOIN [2022_AVG_DLY_PINJAMAN_V2]..PAR_MAPPING_LOAN_AVG_DLY_2022 B
ON A.FKSEGMEN = B.FK_SEGMEN AND A.SANDI = B.SANDI
)

select POSISI, A.REGION, A.MAINBR, A.BRANCH, sum(A.RATAS_MARGINAL) RATAS_MARGINAL,
SUM(A.RATAS_HISTORICAL) RATAS_HISTORICAL, SUM(A.NILAI_TERCATAT) NILAI_TERCATAT, C.FK_SEGMEN, C.FLAG_CUR
 from cte a
INNER JOIN [2022_AVG_DLY_PINJAMAN_V2]..PAR_COA_FKSEGMEN_PPM C
ON A.FKSEGMEN = C.FK_SEGMEN and a.FLAG_CUR = c.flag_cur
group by posisi, region, mainbr, branch, C.fk_segmen, C.FLAG_CUR
order by region, mainbr, branch, C.FK_SEGMEN, C.FLAG_CUR

--FEB
WITH CTE AS (
SELECT POSISI, REGION, MAINBR, BRANCH, 
	RATAS AS RATAS_MARGINAL, RATAS_SALDO_BPR AS RATAS_HISTORICAL,
	NILAI_TERCATAT, A.SANDI, A.PARENT_SANDI, A.FKSEGMEN, B.FLAG_CUR
FROM [2022_AVG_DLY_PINJAMAN_V2]..MASTER_LOANMASTER_202302 A WITH(NOLOCK)
LEFT JOIN [2022_AVG_DLY_PINJAMAN_V2]..PAR_MAPPING_LOAN_AVG_DLY_2022 B
ON A.FKSEGMEN = B.FK_SEGMEN AND A.SANDI = B.SANDI
)

select POSISI, A.REGION, A.MAINBR, A.BRANCH, sum(A.RATAS_MARGINAL) RATAS_MARGINAL,
SUM(A.RATAS_HISTORICAL) RATAS_HISTORICAL, SUM(A.NILAI_TERCATAT) NILAI_TERCATAT, C.FK_SEGMEN, C.FLAG_CUR
 from cte a
INNER JOIN [2022_AVG_DLY_PINJAMAN_V2]..PAR_COA_FKSEGMEN_PPM C
ON A.FKSEGMEN = C.FK_SEGMEN and a.FLAG_CUR = c.flag_cur
group by posisi, region, mainbr, branch, C.fk_segmen, C.FLAG_CUR
order by region, mainbr, branch, C.FK_SEGMEN, C.FLAG_CUR

-- MARET
WITH CTE AS (
SELECT POSISI, REGION, MAINBR, BRANCH, 
	RATAS AS RATAS_MARGINAL, RATAS_SALDO_BPR AS RATAS_HISTORICAL,
	NILAI_TERCATAT, A.SANDI, A.PARENT_SANDI, A.FKSEGMEN, B.FLAG_CUR
FROM MASTER_LOANMASTER_202303 A WITH(NOLOCK)
LEFT JOIN PAR_COA_ENHANCE_AVG_PINJAMAN B
ON A.FKSEGMEN = B.FK_SEGMEN AND A.SANDI = B.SANDI
)
select POSISI, A.REGION, A.MAINBR, A.BRANCH, sum(A.RATAS_MARGINAL) RATAS_MARGINAL,
SUM(A.RATAS_HISTORICAL) RATAS_HISTORICAL, SUM(A.NILAI_TERCATAT) NILAI_TERCATAT, C.FK_SEGMEN, C.FLAG_CUR
 from cte a
INNER JOIN PAR_COA_FKSEGMEN_PPM C
ON A.FKSEGMEN = C.FK_SEGMEN and a.FLAG_CUR = c.flag_cur
group by posisi, region, mainbr, branch, C.fk_segmen, C.FLAG_CUR
order by region, mainbr, branch, C.FK_SEGMEN, C.FLAG_CUR

--APRIL
WITH CTE AS (
SELECT POSISI, REGION, MAINBR, BRANCH, 
	RATAS AS RATAS_MARGINAL, RATAS_SALDO_BPR AS RATAS_HISTORICAL,
	NILAI_TERCATAT, A.SANDI, A.PARENT_SANDI, A.FKSEGMEN, B.FLAG_CUR
FROM MASTER_LOANMASTER_202304 A WITH(NOLOCK)
LEFT JOIN PAR_COA_ENHANCE_AVG_PINJAMAN B
ON A.FKSEGMEN = B.FK_SEGMEN AND A.SANDI = B.SANDI
)
select POSISI, A.REGION, A.MAINBR, A.BRANCH, sum(A.RATAS_MARGINAL) RATAS_MARGINAL,
SUM(A.RATAS_HISTORICAL) RATAS_HISTORICAL, SUM(A.NILAI_TERCATAT) NILAI_TERCATAT, C.FK_SEGMEN, C.FLAG_CUR
 from cte a
INNER JOIN PAR_COA_FKSEGMEN_PPM C
ON A.FKSEGMEN = C.FK_SEGMEN and a.FLAG_CUR = c.flag_cur
group by posisi, region, mainbr, branch, C.fk_segmen, C.FLAG_CUR
order by region, mainbr, branch, C.FK_SEGMEN, C.FLAG_CUR


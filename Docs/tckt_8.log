-- ambil data sikp di 140.118 lalu export ke 141.26
SELECT 
	A.* , B.kode_produk, B.penggunaan, cifno = 'null'
FROM [dbo].[MASTER_LIST_REKENING_SIKP] A WITH(NOLOCK)
INNER JOIN [PAR_LOANTYPE_KUR] B WITH(NOLOCK)
	ON A.TYPE = B.loan_type
  where A.FRELDT_Dt > '1900-01-01 00:00:00.000'
and year(a.freldt_dt) < 2023


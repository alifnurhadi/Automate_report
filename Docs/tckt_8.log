SELECT [POSISI] AS [PERIODE]
,[PN] AS [PN RM]
,[ROLE_GROUP] AS [TIPE RM]
,[CIFNO] AS [CIF NASABAH]
--replace(cifname, right(CIFNAME,len(cifname)/2),'xxxx') 
,replace(cifname, substring(cifname ,len(cifname)/3,len(cifname)),'XXXXX') AS [NAMA NASABAH] --mohon dimasking sesuai arahan DPM
,[JUMLAH REKENING PINJAMAN]=[KKB BRIFINANCE]+[KPR]+[PINJAMAN MIKRO]+[PINJAMAN KECIL]
,[MBDESC] AS [KANTOR CABANG]
,[MAINBR] AS [KODE KC]
,[RGDESC] AS [KANTOR WILAYAH]
,[BRIMO]
,[DPLK]
,[EDC]
,[IBBIZ]
,[QRIS]
,[BRIVA]
,[KARTU KREDIT]
,[BRIGUNA]
,[KPR]
,[PINJAMAN MIKRO]
,[PINJAMAN KECIL]
,[PINJAMAN MENENGAH]
,[BRIMOLA]
,[BANCASSURANCE]
,[SMARTBILLING]
,[JUNIO SMART]
,[KKB BRIFINANCE]
,[SMARTCOOP]
,[TOTAL_PROD]
  FROM [2023_PRODUCT_HOLDING].[dbo].[FACT_RM_PENGELOLA_RINCIAN_202308]
  WHERE [ROLE_GROUP] IN ('RM Small', 'RM Medium')

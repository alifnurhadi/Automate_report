        server : bigdata
        table :0000_staging_raw_as4_cfmast | asrs_fact_savingmaster
        database : datalake
        disclaimer : 1. data bersumber dari ssa product owner dan data ekstraksi brinets dengan kriteria nasabah individu dan warga negara indonesia dengan saldo > 0
2. penentuan tiering saldo berdasarkan akumulasi simpanan aktif nasabah (giro, deposito, tabungan)
3. penentuan uker, kanca, dan kanwil berdasarkan rekening dengan saldo terbesar nasabah
        pengerjaan : pelajari pseudocode lalu jalankan script
posisi yang diminta oktober 2023 query :Di Comment Box pseudo : with saldo_tertinggi as (
    select
    row_number() over(partition by cifno order by cbal_base desc) rn,
    cifno, branch from datamart.ssa_product_owner_daily 
    where ds = '20231031'
    and trim(upper(keterangan)) in ('GIRO', 'TABUNGAN', 'DEPOSITO')
    and status not in (2,4,8)
    and cbal_base > 0
    and trim(upper(`class`)) = 'I'
), tiering as (
    select
    cifno, sum(cbal_base) dpk from datamart.ssa_product_owner_daily 
    where ds = '20231031'
    and trim(upper(keterangan)) in ('GIRO', 'TABUNGAN', 'DEPOSITO')
    and status not in (2,4,8)
    and cbal_base > 0
    and trim(upper(`class`)) = 'I'
    group by cifno
), gabung as (
    select c.rgdesc kanwil, c.mbdesc kanca, c.brdesc uker, b.* from (
        select branch, cifno from saldo_tertinggi
        where rn = 1
    ) a left join tiering b
    on a.cifno = b.cifno
    left join datalake.`6969_crm_dim_dwh_branch` c
    on a.branch = c.branch
) 

select a.kanwil, a.kanca, a.uker,
count(distinct a.cifno) jml_cif_all,
sum(a.dpk) aum_dpk_all,
count(distinct case when a.dpk < 1000000 then a.cifno end) `jml_cif_<_1jt`,
sum(case when a.dpk < 1000000 then a.dpk end) `aum_dpk_<_1jt`,
count(distinct case when a.dpk >= 1000000 and a.dpk < 10000000 then a.cifno end) `jml_cif_1jt_sd_<10jt`,
sum(case when a.dpk >= 1000000 and a.dpk < 10000000 then a.dpk end) `aum_dpk_1jt_sd_<10jt`,
count(distinct case when a.dpk >= 10000000 and a.dpk < 50000000 then a.cifno end) `jml_cif_10jt_sd_<50jt`,
sum(case when a.dpk >= 10000000 and a.dpk < 50000000 then a.dpk end) `aum_dpk_10jt_sd_<50jt`,
count(distinct case when a.dpk >= 50000000 and a.dpk < 300000000 then a.cifno end) `jml_cif_50jt_sd_<300jt`,
sum(case when a.dpk >= 50000000 and a.dpk < 300000000 then a.dpk end) `aum_dpk_50jt_sd_<300jt`,
count(distinct case when a.dpk >= 300000000 and a.dpk < 500000000 then a.cifno end) `jml_cif_300jt_sd_<500jt`,
sum(case when a.dpk >= 300000000 and a.dpk < 500000000 then a.dpk end) `aum_dpk_300jt_sd_<500jt`,
count(distinct case when a.dpk >= 500000000 and a.dpk < 5000000000 then a.cifno end) `jml_cif_500jt_sd_<5m`,
sum(case when a.dpk >= 500000000 and a.dpk < 5000000000 then a.dpk end) `aum_dpk_500jt_sd_<5m`,
count(distinct case when a.dpk >= 5000000000 and a.dpk < 15000000000 then a.cifno end) `jml_cif_5m_sd_<15m`,
sum(case when a.dpk >= 5000000000 and a.dpk < 15000000000 then a.dpk end) `aum_dpk_5m_sd_<15m`,
count(distinct case when a.dpk >= 15000000000 then a.cifno end) `jml_cif_>=15m`,
sum(case when a.dpk >= 15000000000 then a.dpk end) `aum_dpk_>=15m`
from gabung a
inner join ( -- inner join dgn nasabah wni saja
    select `cfcif#`, cfcitz
    from datalake.`0000_staging_raw_as4_cfmast`
    where year = 2023 and month = '10' and day ='31'
    and trim(upper(cfcitz)) = 'ID'
    and trim(upper(cfclas)) = 'I'
) b on a.cifno = b.`cfcif#`
-- where b.`cfcif#` is null
group by a.kanwil, a.kanca, a.uker
; 

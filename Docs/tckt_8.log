# بسم الله الرحمن الرحيم
import re
import datetime
from time import time,sleep
from pytz import timezone
from datetime import datetime, date, timedelta
from dateutil.relativedelta import relativedelta
from pyspark.sql import SparkSession, functions as F, types as T, Window as W,DataFrame
from pyspark.sql.types import StringType
from pyspark.sql.functions import current_timestamp


##              Warnings Config             
#=========================================
import warnings
warnings.simplefilter(action="ignore")

##              Pandas Config             
#=========================================
import pandas as pd
pd.options.display.html.table_schema=True
pd.options.display.max_columns=999
pd.options.display.max_rows=999

##              Spark Session             
#=========================================
spark = SparkSession\
  .builder\
  .appName("Brimo Casa Before After")\
  .config("spark.sql.crossJoin.enabled", "true")\
  .config("spark.dynamicAllocation.enabled", "false")\
  .config("spark.executor.instances", "8")\
  .config("spark.executor.cores", "4")\
  .config("spark.executor.memory", "10g")\
  .config("spark.yarn.executor.memoryOverhead", "4g")\
  .config("spark.ui.showConsoleProgress", "false")\
  .config("spark.sql.legacy.allowCreatingManagedTableUsingNonemptyLocation", "true")\
  .config("spark.network.timeout", "3000")\
  .config("spark.sql.broadcastTimeout", "7200")\
  .config("spark.yarn.queue", "root.cdhdesv")\
  .config('spark.kryoserializer.buffer.max', '1g') \
  .config('spark.scheduler.mode','FAIR')\
  .config("spark.sql.execution.arrow.enabled","true")\
  .config("spark.sql.session.timeZone","Asia/Jakarta")\
  .enableHiveSupport()\
  .getOrCreate()
print(spark.version)

df = spark.sql(f"""
      SELECT
       '2023-11-30' as TGL_LAPORAN,
MBDESC as `Branch Induk`,
RGDESC as `Kanca Induk`,
A.BRANCH as `Branch Uker`,
BRDESC as `Nama Uker`,
count(acctno) JumlahAccount,
KETERANGAN,
sum(CBAL_BASE) as JumlahSaldo
    from datalake.asrs_fact_savingmaster A 
left join datalake.`6969_crm_dim_dwh_branch` B  on A.BRANCH = B.BRANCH
where A.ds='202311' and
A.REGION = 'N' and
cfaref2 is not null and cfaref2 not in ('','0','00','000','0000','0000','00000','000000','0000000','00000000')
and status not in (2,4,8) and SEGMENTASI_BPR <> 'KORPORASI'
group by MBDESC,RGDESC,A.BRANCH,BRDESC,KETERANGAN
      """)

df_pivot = df.groupby("TGL_LAPORAN","Branch Induk","Kanca Induk","Branch Uker","Nama Uker")\
              .pivot("KETERANGAN")\
              .agg(F.sum("JumlahAccount"), F.sum("JumlahSaldo"))

final = df_pivot\
          .withColumnRenamed("DEPOSITO_sum(JumlahAccount)", "Jumlah Rekening DEPOSITO")\
          .withColumnRenamed("DEPOSITO_sum(JumlahSaldo)", "Saldo DEPOSITO")\
          .withColumnRenamed("GIRO_sum(JumlahAccount)", "Jumlah Rekening GIRO")\
          .withColumnRenamed("GIRO_sum(JumlahSaldo)", "Saldo GIRO")\
          .withColumnRenamed("TABUNGAN_sum(JumlahAccount)", "Jumlah Rekening TABUNGAN")\
          .withColumnRenamed("TABUNGAN_sum(JumlahSaldo)", "Saldo TABUNGAN")

final.coalesce(1)\
  .write\
  .mode("overwrite")\
  .format("parquet")\
  .csv(f"hdfs:///user/9171010710940004/ERA23-1866/1/",
      header = True,
      sep = "|") pseudo : None

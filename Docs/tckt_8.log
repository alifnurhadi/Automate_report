SELECT  C.DESC_SEGMEN_LV1, 
		C.DESC_SEGMEN_LV2,
		C.DESC_SEGMEN_LV3, 
		A.[VIKategoriPortfolio],
		A.[IV1DebiturGolonganDebitur],
		SUM([XXIV2JumlahTercatatatauNilaiWajarBulanLaporan]) TOTAL_LOAN,
		SUM(CASE WHEN YEAR([XVI1JangkaWaktuMulai]) = 2017 THEN [XXIV2JumlahTercatatatauNilaiWajarBulanLaporan] END)  AS TOTAL_NEW_LOAN,
		SUM(CASE WHEN [XVIIKualitas] IN ('3', '4', '5') THEN [XXIV2JumlahTercatatatauNilaiWajarBulanLaporan] END)  AS TOTAL_NPL_LOAN
FROM [1000_PAR]..FormLB11ContentHistory_201712 A
LEFT JOIN  [8989_BISDWH_201712].[dbo].[001_LOANMASTER] B ON A.[IINomorRekening] = B.ACCTNO
LEFT JOIN [8989_BISDWH].[dbo].[PAR_SEGMEN_ACRS] C ON B.FKSEGMEN = C.SEGMEN
GROUP BY C.DESC_SEGMEN_LV1, 
		C.DESC_SEGMEN_LV2,
		C.DESC_SEGMEN_LV3, 
		A.[VIKategoriPortfolio],
		A.[IV1DebiturGolonganDebitur]



-------------------------------------------------------------------------------------------------------------------

-- QUERY PENARIKAN DATA PINJAMAN LBUT

SELECT  C.DESC_SEGMEN_LV1, 
		C.DESC_SEGMEN_LV2,
		C.DESC_SEGMEN_LV3, 
		A.[kategoriPortofolio],
		A.[golonganPihakLawan],
		SUM(CONVERT(numeric, JUMLAH)) AS TOTAL_LOAN,
		SUM(CASE WHEN YEAR([tanggalMulai]) = 2022 THEN CONVERT(numeric, JUMLAH) END)  AS TOTAL_NEW_LOAN,
		SUM(CASE WHEN [kualitas] IN ('3', '4', '5') THEN CONVERT(numeric, JUMLAH) END)  AS TOTAL_NPL_LOAN
FROM [1000_PAR]..[LBUT_KRP_202212] A
LEFT JOIN  [8989_BISDWH_202212].[dbo].[001_LOANMASTER] B ON A.[nomorRekening] = CONVERT(VARCHAR, ACCTNO)
LEFT JOIN [8989_BISDWH].[dbo].[PAR_SEGMEN_ACRS] C ON B.FKSEGMEN = C.SEGMEN
GROUP BY C.DESC_SEGMEN_LV1, 
		C.DESC_SEGMEN_LV2,
		C.DESC_SEGMEN_LV3, 
		A.[kategoriPortofolio],
		A.[golonganPihakLawan]

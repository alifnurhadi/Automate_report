        pengerjaan : 
--STEP 1 Server 172.18.41.164
SELECT CIFNO,REGION,OPEN_DATE
 FROM [ASRS_202312].[dbo].[SAVINGMASTER] WITH(NOLOCK)
 WHERE STATUS NOT IN (2,4,8) AND ACCTNO NOT LIKE '%9__' AND CBAL_BASE >= 0.00

--STEP 2 Server: 172.18.40.160
-- 1. BANKWIDE
SELECT COUNT (DISTINCT CIFNO) AS JUMLAH_CIF_BANKWIDE
  FROM [1000_PAR].[dbo].ADHOC_ERA23_2016 A
  INNER JOIN [0000_STAGING_EOM]..AS4_CFMAST B WITH (NOLOCK)
  ON A.CIFNO = B.CFCIF#

-- 2. REGION
WITH REGION AS (
SELECT DISTINCT A.CIFNO,
      COALESCE(CASE WHEN C.REGION = '0' THEN D.REGION ELSE C.REGION END, D.REGION) REGION
      FROM (
      SELECT DISTINCT CIFNO, MIN(OPEN_DATE) DATE
      FROM [1000_PAR]..ADHOC_ERA23_2016 WITH (NOLOCK)
      GROUP BY CIFNO
      ) A
      INNER JOIN [1000_PAR]..ADHOC_ERA23_2016 D WITH (NOLOCK) ON A.CIFNO = D.CIFNO AND A.DATE = D.OPEN_DATE
      INNER JOIN [0000_STAGING_EOM]..AS4_CFMAST B WITH (NOLOCK) ON A.CIFNO = B.CFCIF#
      LEFT JOIN [0000_STAGING_EOM]..DWH_BRANCH C WITH (NOLOCK) ON B.CFBRNN = C.BRANCH
), FINAL AS (
SELECT DISTINCT CIFNO, MAX(REGION) REGION
        FROM REGION
        GROUP BY CIFNO
)
SELECT REGION, COUNT(DISTINCT CIFNO) JUMLAH_CIF_REGIONAL
FROM FINAL
GROUP BY REGION
ORDER BY REGION query :--STEP 1 Server 172.18.41.164

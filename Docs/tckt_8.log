    .option("driver","com.microsoft.sqlserver.jdbc.SQLServerDriver")\
    .option("url","jdbc:sqlserver://{}:{};user={};password={};".format(src_db_ip1,
                                                                   src_db_port1,
                                                                   src_user1,
                                                                   src_pass1))\
    .option("dbtable","""(
    SELECT 
    *
    FROM [BRIMO_SUPERAPPS_SOURCE_{0}].[dbo].[FCT_ESB_DAILY_BRIMO_{0}] a with(nolock)
    where  AmtDebetTotal > 0 and Responcode = '00'
    ) as tmp
    """.format(ym))\
    .load()
    BRIMO.createOrReplaceTempView('BRIMO')
    ds = spark.sql("""
    select distinct
    {0} as PERIODE
    , a.CIF
    , a.NOREK_RDN
    , sum(case when b.FiturId in ('NBMB00008','NBMB00015') then b.JmlTrxTotal else 0 end) as TRANSFER
    ,sum(case when b.FiturId in (
    'NBMB01001','NBMB01002','NBMB01004','NBMB01005','NBMB01006','NBMB01007','NBMB01008','NBMB01009'
    ,'NBMB01024','NBMB01026') then b.JmlTrxTotal else 0 end) AS PEMBELIAN 
    ,sum(case when b.FiturId in (
    'NBMB0002Q','NBMB0002R','NBMB0002Z','NBMB00032','NBMB00033','NBMB00050','NBMB0005X','NBMB01011',
    'NBMB01013','NBMB01015','NBMB01017','NBMB01023','NBMB02002','NBMB03002','NBMB03005','NBMB03007',
    'NBMB03008','NBMB0300C','NBMB0300C','NBMB04002','NBMB04002','NBMB04004','NBMB04004','NBMB06006','NBMB0600C',
    'NBMB0600C','NBMB07002','NBMB07003','NBMB07005','NBMB07007','NBMB07009','NBMB0700B','NBMB1000C','NBMB1000C'
    ) then b.JmlTrxTotal else 0 end) AS PEMBAYARAN
    ,sum(case when b.FiturId in ('NBMB02004','NBMB02006','NBMB02010','NBMB02011') then b.JmlTrxTotal else 0 end) AS TOPUP
    from tempp a 
    left join BRIMO b
    on a.ACCTNO = b.AccDebet
    group by a.CIF
    , a.NOREK_RDN
    """.format(ym))
    ds.createOrReplaceTempView("ds")
    Final = spark.sql("""
    select distinct
     *,  (Transfer+Pembelian+Pembayaran+TopUp) as Total
    FROM ds a 
    
    """)
    Final.createOrReplaceTempView("Final")
    
    Final1 = spark.sql("""
    select distinct
     *
    FROM Final a 
    
    """)
    Final1.createOrReplaceTempView("Final1")   
	
	

        pengerjaan : None query :on comment pseudo : declare
 @query as varchar(5000),
 @POSISI_HARI_INI_date date,
 @POSISI_HARI_INI AS varchar(10),
 @POSISI_BULAN_LALU as varchar(10);


set @POSISI_HARI_INI_date = ? --> ganti posisi tgl 6 des asrs daily

set @POSISI_HARI_INI = convert(varchar(8), @POSISI_HARI_INI_date, 112)

set @POSISI_BULAN_LALU =
	case
		when exists (Select * from INFORMATION_SCHEMA.TABLES where TABLE_NAME = 'FACT_SAVINGMASTER_' + (select max(convert(varchar(6), POSISI, 112)) from ASRS_FACT..PAR_POSISI_MONTHLY))
		then (select max(convert(varchar(6), POSISI, 112)) from ASRS_FACT..PAR_POSISI_MONTHLY)
		else
			(
				select convert(varchar(8), DATEADD(month, DATEDIFF(month, 0, dateadd(month, -1, POSISI))+1, -1), 112)
				from ASRS_FACT..PAR_POSISI_DAILY
			)
	end --> ambil fact_savingmaster_202311

set @query =
'
select *
from
(
select
 row_number () over (partition by c.brname, a.segmentasi_bpr_type2, a.group_desc1 order by (a.CBAL_BASE - b.CBAL_BASE) asc) rono,
 a.POSISI,
 a.CIFNO,
 a.acctno as NO_REKENING, 
 a.type AS PRODUCT_TYPE, 
 a.pscdes as KET_PRODUCT_TYPE,
 a.sname as NAMA_NASABAH,
 a.JENIS_NASABAH,
 a.rgdesc as REGIONAL_OFFICE,
 c.region as KODE_REGIONAL_OFFICE, 
 a.mainbr AS KODE_CABANG_INDUK, 
 a.mbdesc AS CABANG_INDUK, 
 a.branch AS KODE_UKER, 
 c.brname AS UNIT_KERJA, 
 a.SEGMENTASI_BPR_TYPE2 AS SEGMENTASI_BPR, 
 a.group_desc1 as JENIS_SIMPANAN, 
 b.CBAL_BASE  AS SALDO_HARI_KEMARIN, 
 a.CBAL_BASE as SALDO_HARI_INI, 
 a.CBAL_BASE - B.CBAL_BASE as delta,
 a.cfaref AS PN_SLOT_1, 
 a.cfaref2 AS PN_SLOT_2, 
 a.cfaref3 AS PN_SLOT_3, 
 a.cfaref4 AS PN_SLOT_4, 
 a.cfaref5 AS PN_SLOT_5, 
 a.cfaref6 AS PN_SLOT_6, 
 a.cfaref7 AS PN_SLOT_7, 
 a.cfaref8 AS PN_SLOT_8
from
 ASRS_FACT..FACT_SAVINGMASTER_'+@POSISI_HARI_INI+' a with(nolock)
 inner join ASRS_FACT..FACT_SAVINGMASTER_'+@POSISI_BULAN_LALU+' b with(nolock) on a.acctno = b.acctno
 left join ASRS_FACT..PAR_DWH_BRANCH c with(nolock) on a.branch = c.branch
where a.SEGMENTASI_BPR_TYPE2 = 'ritel'
group by 
 a.posisi, 
 a.acctno, 
 a.type, 
 a.sname, 
 a.rgdesc,
 a.MAINBR,
 a.mbdesc,
 a.BRANCH,
 c.brname,
 a.SEGMENTASI_BPR_TYPE2,
 a.GROUP_DESC1, 
 a.cfaref,
 a.cfaref2,
 a.cfaref3,
 a.cfaref4, 
 a.cfaref5, 
 a.cfaref6, 
 a.cfaref7,
 a.cfaref8, 
 a.cbal_base,
 b.cbal_base,
 c.region,
 a.cifno, 
 a.pscdes,
 a.JENIS_NASABAH
) x
where rono between 1 and 100
'


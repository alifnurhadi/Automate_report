        server : 172.18.140.49 | 172.18.41.164 | bigdata
        table :savingmaster | asrs_fact_savingmaster
        database : asrs_yyyymm | datalake
        disclaimer : data bersumber dari datamart simpanan (asrs).
        pengerjaan : Ada 3 Poin yang diprovide untuk posisi 2015 s.d Q3 2023:
1. Total new deposits (flows) -> total simpanan baru tahun berjalan (Tabungan + Giro + Deposito)
2. Total new demand deposits -> total tabungan baru tahun berjalan (Tabungan + Giro)
3. Total new deposits by segment (Tabungan + Giro + Deposito):
  - Individual/Housholds (segmen konsumer)
  - MSMEs (segmen Mikro dan SME)
  - Corporate (segmen korporasi (non-BUMN))
  - SOEs (segmen korporasi (BUMN))
  - Government (segmen pemerintah) query :On comment pseudo : Contoh query untuk tahun 2022:
Poin 1
select sum(cbal_base) from datamart.ssa_product_owner_monthly 
where 
keterangan in ('TABUNGAN','GIRO','DEPOSITO')
AND YEAR(open_date) = 2022 
AND ds = '202212'

Poin 2
select sum(cbal_base) from datamart.ssa_product_owner_monthly
where
keterangan in ('TABUNGAN','GIRO')
AND YEAR(open_date) = 2022
AND ds = '202212'

Poin 3
SELECT 
POSISI,
PRODUK,
KET1,
SUM(SALDO) AS SALDO
FROM
(
    SELECT
    POSISI,
    KETERANGAN AS PRODUK,
    SEGMENTASI,
    CASE
    WHEN KETERANGAN IN ('DEPOSITO','GIRO') AND SEGMENTASI NOT IN ('DIVMKR','DIVMSB') AND CIFNO IN (SELECT CIFNO FROM [1000_PAR].[dbo].[LIST_CIF_GOVERMENT_SIMPANAN])  THEN 'GOVERMENT'
    WHEN KETERANGAN IN ('DEPOSITO','GIRO') AND SEGMENTASI NOT IN ('DIVMKR','DIVMSB') AND CIFNO IN (SELECT CIF FROM [1000_PAR].[dbo].[LIST_CIF_BUMN_SIMPANAN]) THEN 'SOE'
    WHEN KETERANGAN IN ('DEPOSITO','GIRO') AND SEGMENTASI NOT IN ('DIVMKR','DIVMSB') AND CIFNO NOT IN (SELECT CIF FROM [1000_PAR].[dbo].[LIST_CIF_BUMN_SIMPANAN]) THEN 'CORPORATE'
    WHEN SEGMENTASI = 'DIVMKR' THEN 'MSME'
    ELSE 'INDIVIDUAL'
    END AS KET1,
    (CBAL_BASE) AS SALDO
    FROM ASRS_201612..SAVINGMASTER A
    LEFT JOIN [1000_PAR].[dbo].[LIST_CIF_BUMN_SIMPANAN] B ON A.CIFNO=B.CIF
    WHERE YEAR(OPEN_DATE)=2016
) AS GAB
GROUP BY
POSISI,
PRODUK,
KET1

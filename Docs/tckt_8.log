WITH REGION AS (
SELECT DISTINCT A.CIFNO,
      COALESCE(CASE WHEN C.REGION = '0' THEN D.REGION ELSE C.REGION END, D.REGION) REGION
      FROM (
      SELECT DISTINCT CIFNO, MIN(OPEN_DATE) DATE
      FROM [1000_PAR]..[era23_825] WITH (NOLOCK)

        pengerjaan : None query :On comment pseudo :  CTE_FITUR AS (
SELECT FiturId
,Fitur =
'Tarik Tunai'
,GroupName
FROM [MASTER_ECHANNEL].[dbo].[DWH_ECHANNEL_GROUP_FITUR] b with (nolock)
WHERE b.CategoryID = '1'
and b.GroupName = 'TarikTunai' and b.FiturID <> 103090171 --INI FiturID ATM
)
select
c.mbdesc,c.brdesc,
[PERIODE] = LEFT(convert(varchar(10),[transdate],120),10),termid
,NILAI = SUM(a.[txamount]/100.00)
FROM [ECHANNEL].[dbo].[DWH_PROSW_TRANSACTION_20231101] a with (nolock)
inner join [CTE_FITUR] b with (nolock)
on b.FiturId = a.FiturID
inner join dwh_branch c on a.brnchcode = c.branch
inner join echannel..fasilitas_rekening d on a.acctno = d.acctno
inner join 6969_crm..DLY_CUSTOMER_INFO e on e.cifno = d.cifno
where 1=1
and [responcode] = '00'
and a.[TerminalType] in ('ATM MERAH PUTIH','ATM_BRI','CDM') and c.region = 'R' and LEFT(convert(varchar(10),[transdate],120),10) = '2023-11-04'
group by c.mbdesc,c.brdesc,
LEFT(convert(varchar(10),[transdate],120),10),termid

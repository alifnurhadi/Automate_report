with pengajuan_kredit_briguna as (SELECT eforms.ref_number,
    left(convert(varchar(20),eforms.created_at,121),7) created_at,
eforms.created_at created_at_1,
    eforms.prescreening_status,
    eforms.ao_name AS username,
    eforms.ao_position,
    eforms.pinca_name,
    eforms.is_screening,
    eforms.branch_id,
    eforms.branch,
    eforms.kanca_id,
    eforms.kanwil_id,
    eforms.flag_v3,
    eforms.prescreening_version,
    eforms.pinca_position,
    briguna.id,
    briguna.id_aplikasi,
    briguna.no_rekening,
    briguna.request_amount,
    briguna."Plafond_usulan",
    briguna.is_send,
    briguna.eform_id,
    briguna.tp_produk,
    briguna.tgl_pencairan,
    briguna.tgl_analisa,
    briguna.tgl_putusan,
    briguna.cif,
    customer_details.nik,
    customer_details.is_verified,
    customer_details.address,
    customer_details.mother_name,
    customer_details.birth_date,
    concat(users.first_name, ' ', users.last_name) AS nama_debitur,
    users.mobile_phone,
    users.gender,
        CASE
            WHEN eforms.ao_id IS NOT NULL OR eforms.ao_id <> '' THEN 'Disposisi Pengajuan'
            ELSE 'Pengajuan Kredit'
        END AS status_pengajuan,
        CASE
            WHEN briguna.tp_produk = '1' AND briguna.jenis_pinjaman_id = 1 THEN 'Briguna Karya'
            WHEN briguna.tp_produk = '1' AND briguna.jenis_pinjaman_id = 2 THEN 'Briguna Umum'
            WHEN briguna.tp_produk = '2' THEN 'Briguna Purna'
            WHEN briguna.tp_produk = '10' THEN 'Briguna Micro'
            WHEN briguna.tp_produk = '22' THEN 'Briguna Talangan'
            WHEN briguna.tp_produk = '28' THEN 'Briguna Pekerja BRI'
            ELSE 'Briguna Lainnya'
        END AS product,
        CASE
            WHEN briguna.is_send = 0 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 1 THEN 'APPROVED'
            WHEN briguna.is_send = 2 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 3 THEN 'DITOLAK'
            WHEN briguna.is_send = 4 THEN 'VOID ADK'
            WHEN briguna.is_send = 5 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 6 THEN 'DISBURSED'
            WHEN briguna.is_send = 7 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 8 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 9 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 10 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 11 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 12 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 13 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 14 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 15 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 16 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 17 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 18 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 19 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 20 THEN 'MENUNGGU PUTUSAN'
            WHEN briguna.is_send = 21 THEN 'MENGEMBALIKAN DATA KE AO'
            WHEN briguna.is_send = 22 THEN 'PENDING'
            ELSE '-'
        END AS status_putusan
   FROM EDW_EFORMS eforms
     JOIN EDW_BRIGUNA briguna ON briguna.eform_id = eforms.id
     JOIN EDW_CUSTOMER_DETAILS customer_details ON customer_details.user_id = eforms.user_id
     JOIN EDW_users users ON users.id = eforms.user_id
	 )
SELECT count(0) jml_trx_pengajuan_kredit
FROM
pengajuan_kredit_briguna
JOIN EDW_EFORMS eforms ON eforms.ID = pengajuan_kredit_briguna.eform_id
JOIN EDW_BRIGUNA briguna ON briguna.eform_id = pengajuan_kredit_briguna.eform_id
JOIN [0000_Staging].[dbo].[DWH_BRANCH] ukers ON ukers.BRANCH = pengajuan_kredit_briguna.branch_id
WHERE
pengajuan_kredit_briguna.created_at between '2023-01' and '2023-09'
AND eforms.status_eform = 'Disbursed' and ukers.REGION = 'F'


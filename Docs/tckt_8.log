query dibawah diexec sesuai db periode masing sesuai periode yg diminta query :Di Comment Box pseudo : qris
WITH DATAS AS (
SELECT  STOREID, COUNT(1) AS JUMLAH_TRX , SUM(SALES_VOLUME) AS SALES_VOLUME, JENIS, MERCHANT_TYPE FROM
(
SELECT 
 A.StoreId
,a.[AmountTrx]/100 as SALES_VOLUME
, JENIS = ''On us'' 
, MERCHANT_TYPE = CASE WHEN CONVERT(VARCHAR(20),B.BRI_MERCHANT_TYPE) = ''edc'' THEN ''DINAMIS'' 
				when CONVERT(VARCHAR(20),B.BRI_MERCHANT_TYPE) = ''mocash'' THEN ''STATIS'' END
FROM ['+@DB4+'].[dbo].[QRISOnUs] a with (nolock) 
INNER JOIN  ['+@DB4+'].[dbo].[TBL_MERCHANT] B WITH (NOLOCK)
ON A.STOREID = B.MID AND A.MPANBri = B.MPAN
where CONVERT (DATE,a.TrxDate) BETWEEN DATEADD(MONTH,DATEDIFF(MONTH,0,'''+@PERIODE+'''),0) AND '''+@PERIODE+'''
UNION ALL
SELECT 
 A.StoreId
,a.[AmountTrx]/100 as SALES_VOLUME
, JENIS = ''Off us''
, MERCHANT_TYPE = CASE WHEN CONVERT(VARCHAR(20),A.MerchantType) = ''edc'' THEN ''DINAMIS'' 
				when CONVERT(VARCHAR(20),A.MerchantType) = ''mocash'' THEN ''STATIS'' END
FROM ['+@DB4+'].[dbo].[LogPortalQRISOffUs] a with (nolock) 
where CONVERT (DATE,a.TrxDate) BETWEEN DATEADD(MONTH,DATEDIFF(MONTH,0,'''+@PERIODE+'''),0) AND '''+@PERIODE+'''
UNION ALL
SELECT 
a.PARTNERMERCHANTID as StoreID
, a.TRANSACTION_AMOUNT AS SALES_VOLUME
, JENIS =''LINKAJA'' 
, MERCHANT_TYPE = ''LINKAJA''
FROM ['+@DB4+'].[dbo].PAYMENT_LINKAJA A with (nolock)
INNER JOIN MASTER_MERCHANT..PAR_MERCHANT_LINKAJA_NEW B WITH (NOLOCK)
on a.PARTNERMERCHANTID = b.MID AND UKER IS NOT NULL
WHERE CONVERT(DATE,A.LAST_UPDATED_TIME)  BETWEEN DATEADD(MONTH,DATEDIFF(MONTH,0,'''+@PERIODE+'''),0) AND '''+@PERIODE+'''
) T
GROUP BY  STOREID, JENIS, MERCHANT_TYPE
)
SELECT 
[PERIODE] = CONVERT(VARCHAR(7),CONVERT(DATE,'''+@PERIODE+'''),120)
, POSISI = '''+@PERIODE+'''
, StoreId
, SALES_VOLUME 
, JUMLAH_TRX
, MERCHANT_TYPE
, JENIS
, STATUS = ''Aktif''
FROM DATAS 

edc bri
SELECT DISTINCT 
		 [POSISI] = ''20220731''
		,B.[REGION]
		,B.[RGDESC]
		,B.[MAINBR]
		,B.[MBDESC]
		,B.[BRANCH]
		,B.[BRDESC]
		,A.TID
		,A.MID
		,A.NAMA_MERCHANT
		,F.KETERANGAN AS MCC
		,dbo.fnRemoveNonNumericCharacters(C.pic_pn) as PN
		,C.pic_name  as PN_PEMRAKARSA
		,E.STELL_TX as JABATAN
		,''MERCHANT EDC'' as SUMBER
		,[SV_NOMINAL] = SUM(ISNULL([NOMINAL],0))
		,[JML_TRX] = SUM(ISNULL([JUMLAH],0))
	FROM [MERCHANT_202207]..[DWH_BRANCH] B WITH (NOLOCK)
	LEFT JOIN [MERCHANT_202207]..[FCT_SALES_VOLUME_EDC_MERCHANT_DAILY] A WITH (NOLOCK)
	ON case when isnumeric(A.BRANCH) = 0 then 229 else A.BRANCH end = B.[BRANCH]
	LEFT JOIN [MERCHANT_202207].[dbo].[ETL_MOCASH_STORE]  C  with (nolock) 
	on a.[TID] = C.store_code
	LEFT JOIN [MICROPAYMENT].[dbo].[PA0001_EOF_ALL] E with (nolock)
	ON convert(int,dbo.fnRemoveNonNumericCharacters(C.pic_pn)) = Convert(int,E.PERNR)
	LEFT JOIN [MASTER_MERCHANT].[dbo].[PAR_REFERENSI_MCC_QRIS] F with (nolock)
	ON c.mcc = F.KODE_MCC
	AND A.[TANGGAL]  BETWEEN DATEADD(MONTH,DATEDIFF(MONTH,0,''20220731''),0) AND ''20220731''
	GROUP BY B.[REGION]
		,B.[RGDESC]
		,B.[MAINBR]
		,B.[MBDESC]
		,B.[BRANCH]
		,B.[BRDESC]
		,A.TID
		,A.MID
		,A.NAMA_MERCHANT

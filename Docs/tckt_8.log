        pengerjaan : None query :query final pada kolom komentar pseudo : /****** Script for SelectTopNRows command from SSMS  ******/
with atmlokasi as (
SELECT tid,kc_spv,mesin,ech,pengelola_jenis,lokasi,lokasi_jenis,kanwil
  FROM [000_JKE].[dbo].[1500_1011_atm_zona]
  union all
  SELECT tid,kc_spv,mesin,ech,pengelola_jenis,lokasi,lokasi_jenis,kanwil
  FROM [000_JKE].[dbo].[1500_1011_crm_zona]),
  atmlokasifinal as (select * from atmlokasi where kanwil like '%yog%'),
  CTE_FITUR AS (
	SELECT FiturId
		,Fitur = 
		'Tarik Tunai'
		,GroupName
		FROM [MASTER_ECHANNEL].[dbo].[DWH_ECHANNEL_GROUP_FITUR] b with (nolock)
	WHERE b.CategoryID = '1'
	and b.GroupName = 'TarikTunai' and b.FiturID <> 103090171 --INI FiturID ATM
)
select 
	[PERIODE] = LEFT(convert(varchar(10),[transdate],120),7)
	,tid,kc_spv,mesin,ech,pengelola_jenis,lokasi,lokasi_jenis,GroupName
	,NILAI = SUM(a.[txamount]/100.00)
	,JUMLAH = COUNT(0)
FROM [ECHANNEL].[dbo].[DWH_PROSW_TRANSACTION_20231101] a with (nolock) 
inner join [CTE_FITUR] b with (nolock)
	on b.FiturId = a.FiturID
inner join atmlokasifinal c on c.tid = case when isnumeric(a.termid) = 1 then cast(a.termid as decimal(19,0)) else 0 end
where 1=1
and [responcode] = '00'
and a.[TerminalType] in ('ATM MERAH PUTIH','ATM_BRI','CDM')
group by LEFT(convert(varchar(10),[transdate],120),7),tid,kc_spv,mesin,ech,pengelola_jenis,lokasi,lokasi_jenis,GroupName
